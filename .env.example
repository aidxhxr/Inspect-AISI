# Copy to .env (Inspect reads it automatically). Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Models for the suite runner, comma separated.
AISI_MODELS=openai/gpt-5,anthropic/claude-sonnet-4.6
# Grader model used by model-graded scorers.
AISI_GRADER=openai/gpt-5
# Default model for `inspect eval` when --model is not passed.
INSPECT_EVAL_MODEL=openai/gpt-5
INSPECT_LOG_DIR=./logs
